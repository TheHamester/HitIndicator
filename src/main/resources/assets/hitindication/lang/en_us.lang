
hitindication.gui.config.main_title=Hit Indicators Config

hitindication.gui.config.indicators.enable_hit_indication=Enable Hit Indication
hitindication.gui.config.indicators.enable_hit_indication.tooltip=Enables hit indication.

hitindication.gui.config.indicators.max_indicator_count=Max Indicator Count
hitindication.gui.config.indicators.max_indicator_count.tooltip=Determines maximum indicator count shown on screen (0 means unlimited). Upon exceeding the oldest indicator will be removed.

hitindication.gui.config.indicators.display_hits_from_negative_potions=Display Hits From Non-Damaging Negative Potions
hitindication.gui.config.indicators.display_hits_from_negative_potions.tooltip=Shows red indicator when an entity hits the player with a non-damaging negative potion.

hitindication.gui.config.indicators.size_depends_on_damage=Heavy damage makes indicator larger
hitindication.gui.config.indicators.size_depends_on_damage.tooltip=Any instance of damage that deals 30 percent or more of max health will result in larger indicators.

hitindication.gui.config.indicators.indicator_default_scale=Indicator Default Scale (0-100)
hitindication.gui.config.indicators.indicator_default_scale.tooltip=Determines scale of indicators.

hitindication.gui.config.indicators.fade_rate=Indicator Fade Rate (Ticks)
hitindication.gui.config.indicators.fade_rate.tooltip=Amount of ticks after which indicator disappears.

hitindication.gui.config.indicators.indicator_opacity=Indicator Opacity (0-100)
hitindication.gui.config.indicators.indicator_opacity.tooltip=Determines opacity of the indicators.

hitindication.gui.config.indicators.display_blue_indicators=Show Block Indicator
hitindication.gui.config.indicators.display_blue_indicators.tooltip=Shows blue indicator when the player blocks incoming damage with a shield.

hitindication.gui.config.indicators.enable_hit_markers=Enable Crit/Kill Markers
hitindication.gui.config.indicators.enable_hit_markers.tooltip=Enables hit markers on crit/kill.

hitindication.gui.config.indicators.enable_distance_scaling=Enable Distance Scaling
hitindication.gui.config.indicators.enable_distance_scaling.tooltip=Scale of the indicator depends on the distance.

hitindication.gui.config.indicators.distance_scaling_cutoff=Distance Scaling Cutoff
hitindication.gui.config.indicators.distance_scaling_cutoff.tooltip=Distance from entity after which indicator starts to become gradually smaller.

hitindication.gui.config.indicators.enable_non_directional_damage=Enable Non-Directional Damage Indicator
hitindication.gui.config.indicators.enable_non_directional_damage.tooltip=Shows a special indicator when hit direction can't be determined.

hitindication.gui.config.indicators.distance_from_crosshair=Distance From Crosshair
hitindication.gui.config.indicators.distance_from_crosshair.tooltip=Determines distance of an indicator from crosshair.

hitindication.gui.config.indicators.edge_of_screen_mode=Edge of Screen Mode
hitindication.gui.config.indicators.edge_of_screen_mode.tooltip=The indicators will appear on the edges of your screen instead of near the crosshair

hitindication.gui.config.indicators.hit_indicator_color=Hit Indicator Color
hitindication.gui.config.indicators.hit_indicator_color.tooltip=Determines the color of the hit indicator

hitindication.gui.config.indicators.block_indicator_color=Block Hit Indicator Color
hitindication.gui.config.indicators.block_indicator_color.tooltip=Determines the color of the block indicator

hitindication.gui.config.indicators.proximity_indicator_color=Proximity Indicator Color
hitindication.gui.config.indicators.proximity_indicator_color.tooltip=Determines the color of the proximity indicator

hitindication.gui.config.indicators.enable_proximity_indicators=Enable Proximity Indicators
hitindication.gui.config.indicators.enable_proximity_indicators.tooltip=Enables proximity indicators

hitindication.gui.config.indicators.proximity_indicator_radius=Proximity Indicator Radius
hitindication.gui.config.indicators.proximity_indicator_radius.tooltip=Determines the radius within which proximity indicators will be shown

hitindication.gui.config.indicators.proximity_indicator_border=Proximity Indicator Border
hitindication.gui.config.indicators.proximity_indicator_border.tooltip=Determines the border radius of the proximity indicator for better contrast

key.categories.hitindication=Hit Indication
key.hitindication.toggle_hit_indication=Toggle Hit Indication
key.hitindication.toggle_proximity_indicators=Toggle Proximity Indicators
key.hitindication.toggle_edge_of_screen_mode=Toggle Edge of Screen Mode